# Local development only. Export these variables in your shell or set them in your IDE.
# Docker Compose reads .env automatically; Spring Boot does not.
POSTGRES_DB=clubs
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/clubs
DB_USERNAME=clubs
DB_PASSWORD=clubs_local

# Enable 42 login after registering this callback in the 42 OAuth application.
AUTH_ENABLED=false
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_REDIRECT_URI=http://localhost:8080/login/oauth2/code/42
AUTH_SUCCESS_URL=http://localhost:5173/auth/callback
AUTH_ALLOWED_ORIGINS=http://localhost:5173
# Set secure=true on HTTPS deployments. Use SameSite=none only for cross-site clients.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
