# Local development only. Export these variables in your shell or set them in your IDE.
# Docker Compose reads .env automatically; Spring Boot does not.
# See docs/environment-variables.md for defaults, requirements, and local login testing.
# Compose public entry point (Nginx); use 0.0.0.0 for LAN/home-server access.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Compose fixes this to framework; host runs normally leave it unset.
# SERVER_FORWARD_HEADERS_STRATEGY=framework
POSTGRES_DB=clubs
# Only used by compose.dev.yaml (host/IDE database access).
POSTGRES_PORT=5432
# Host/IDE only; Compose backend always connects to the postgres service.
DB_URL=jdbc:postgresql://localhost:5432/clubs
DB_USERNAME=clubs
DB_PASSWORD=clubs_local

# Enable 42 login after registering this callback in the 42 OAuth application.
AUTH_ENABLED=false
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_REDIRECT_URI=http://localhost:8080/login/oauth2/code/42
AUTH_SUCCESS_URL=http://localhost:5173/auth/callback
AUTH_ALLOWED_ORIGINS=http://localhost:5173
# Set secure=true on HTTPS deployments. Use SameSite=none only for cross-site clients.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Activity photos: local by default, no AWS credentials required.
# Compose fixes mode=local and directory=/app/data/photos (named volume); base URL is used.
PHOTO_STORAGE_MODE=local
PHOTO_LOCAL_DIRECTORY=./data/photos
PHOTO_LOCAL_BASE_URL=http://localhost:8080
# Optional S3 mode (PHOTO_STORAGE_MODE=s3; AWS SDK default credentials chain).
PHOTO_S3_BUCKET=
PHOTO_S3_REGION=ap-northeast-2
# Optional HTTPS image domain; blank uses signed GET URLs (15 minutes).
PHOTO_PUBLIC_BASE_URL=
